{
  "version": 1,

  "materials": [
    {
      "name": "lit",
      "shader": "project://Shaders/LightModels.glsl",
      "uniforms": {
        "u_LightDir":   [0.75, 1.0, 0.5],
        "u_LightColor": [1.0, 0.9, 0.8],
        "u_Roughness":  0.3
      }
    }
  ],

  "entities": [
    {
      "name": "MainCamera",
      "components": [
        {
          "type": "transform",
          "position": [0.0, 0.25, 2.0]
        },
        {
          "type": "camera",
          "projection": "perspective",
          "fov":  60.0,
          "near": 0.1,
          "far":  1000.0
        },
        {
          "type": "camera_controller",
          "move_speed":       0.5,
          "look_sensitivity": 0.002
        }
      ]
    },

    {
      "name": "Bunny",
      "components": [
        {
          "type": "transform",
          "scale": [2.0, 2.0, 2.0]
        },
        {
          "type": "mesh",
          "path":     "project://Meshes/bunny.obj",
          "material": "lit"
        }
      ]
    },

    {
      "name": "Floor",
      "components": [
        {
          "type": "transform",
          "rotation": [-90.0, 0.0, 0.0],
          "scale":    [5.0, 5.0, 5.0]
        },
        {
          "type": "mesh",
          "path":     "builtin://Quad",
          "material": "lit"
        }
      ]
    }
  ]
}
