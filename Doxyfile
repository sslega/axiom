# Local API reference for Axiom. Run the VS Code task "Doxygen", then "Doxygen: Open"
# (output: build/doxygen/html/index.html). Only non-default settings are listed.

PROJECT_NAME           = Axiom
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = Engine/src Editor/src Game/src
RECURSIVE              = YES
FILE_PATTERNS          = *.h

# Show #include paths the way the code writes them, e.g. "Scene/Entity.h".
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = Engine/src Editor/src Game/src

# List everything, documented or not. Private members stay out of the reference.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Theme: doxygen-awesome-css, sidebar-only layout. It follows the system's light/dark setting.
# LIGHT is required by the theme on Doxygen 1.9.5 and newer; it doesn't mean light mode.
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = Tools/doxygen-awesome/doxygen-awesome.css Tools/doxygen-awesome/doxygen-awesome-sidebar-only.css

# Graphs can be turned on later with Graphviz.
HAVE_DOT               = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
